# AutoFixOps Environment Configuration
# Copy this file to .env and fill in your actual values

# PostgreSQL (NeonDB or local)
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# MongoDB Atlas
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/

# GitHub (for PR creation)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=your-username/your-infra-repo

# Shadow Mode (true = PRs are drafts, false = PRs are ready to merge)
SHADOW_MODE=true

# AI Incident Analysis stage (default true): context + runbook RAG + LLM report, then STOP
# at DIAGNOSED (no policy, no remediation). false = legacy diagnosis → policy → remediation.
AI_INCIDENT_ANALYSIS=true
# LLM provider: ollama (default, free, local) | openai (paid; needs OPENAI_API_KEY)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
# OpenAI fallback (only used when LLM_PROVIDER=openai). Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
# Runbook retrieval: tested relevant scores are ~0.4–0.7, irrelevant ~0.1–0.3.
RAG_RUNBOOK_MIN_SCORE=0.35
RAG_RUNBOOK_TOP_K=3

# Presentation-only: stop after policy evaluation; normal pipeline default is false.
PIPELINE_STOP_AFTER_POLICY=false

# Prometheus
PROMETHEUS_URL=http://prometheus-operated.autofixops.svc.cluster.local:9090

# Redis
REDIS_URL=redis://localhost:6379/0

# RAG / Qdrant storage (see docs/RAG.md). Leave both unset for in-memory (not persisted).
# QDRANT_PATH: local on-disk store, one process at a time. QDRANT_URL: Qdrant server.
QDRANT_PATH=
QDRANT_URL=

# Target Manifest Path (relative to the repo root)
TARGET_MANIFEST_PATH=kubernetes_integration/target_app/deployment.yaml

# Debug Tracing — capture full prompts, raw LLM responses, RAG hits, and timing
# per incident to debug_traces/<incident_id>.json. Structured debug logging is
# always emitted to the worker log regardless of this setting.
# Traces are served via GET /api/v1/incidents/{id}/debug.
DEBUG_PROMPTS=false
# DEBUG_TRACES_DIR=debug_traces

# Stage 2 AI patch proposals (proposal only — never applied, committed or deployed).
# After AI diagnosis: confidence >= 0.80 queues one proposal automatically; below
# 0.80 a human must approve on the incident page first. false = nothing starts on its
# own (neither after diagnosis nor on page load); the incident page shows a Generate button.
PATCH_PROPOSALS_AUTO=true

# ─── Stages 3-4: approval -> GitHub PR -> controlled deployment -> verification ───
# Every remediation needs a human approval of the exact validated proposal.
# Approver authentication: "name:token" pairs (tokens >= 16 chars). When set, approve/
# reject/close/advance require "Authorization: Bearer <token>" and the name is recorded.
# When empty, only requests from this machine (loopback) are accepted and recorded as
# unauthenticated: LOCAL DEMONSTRATION ONLY - never expose the API publicly without it.
APPROVER_TOKENS=
# true (default): a GitHub PR must be opened and merged unchanged before deployment
# (needs GITHUB_TOKEN + GITHUB_REPO above, or a service account). false: local-only demo,
# the PR step is recorded as skipped.
REMEDIATION_REQUIRE_PR=true
REMEDIATION_PR_POLL_SECONDS=30
# Deploy a merged PR only after GitHub Actions succeeded on its commit (token needs actions: read).
REMEDIATION_REQUIRE_CI=true
# Deployment is OFF unless DEPLOY_MODE=kubectl. SHADOW_MODE=true (above) or system mode
# SHADOW also blocks deployment. Only the listed namespace/deployment pairs can be changed;
# protected namespaces (prod, billing, payments, kube-system) are always refused.
DEPLOY_MODE=disabled
DEPLOY_KUBE_CONTEXT=docker-desktop
DEPLOY_ALLOWED_TARGETS=autofixops/autofixops-target-app
# KUBECTL_PATH=kubectl
DEPLOY_ROLLOUT_TIMEOUT_SECONDS=120
# Recovery verification (required for deployment): health URL of the deployed target
# (Kubernetes demo NodePort), check interval, how long every check must stay green,
# and the deadline after which the change is rolled back.
# http(s) URL, or through the API server's service proxy (Docker Desktop's kind cluster publishes no NodePorts):
VERIFY_HEALTH_URL=kube-service://autofixops/target-app-nodeport:80/health
VERIFY_INTERVAL_SECONDS=10
VERIFY_STABILIZATION_SECONDS=60
VERIFY_TIMEOUT_SECONDS=300
# Telemetry: Prometheus scrape job and Kubernetes workload name of the target app.
# TARGET_SCRAPE_JOB=autofixops-target
# TARGET_WORKLOAD=autofixops-target-app
# Crash-loop chaos for the Kubernetes demo via POST /api/v1/chaos/kubernetes (dashboard Chaos page).
CHAOS_K8S_ENABLED=false
